# Maintainer: Reasonix <reasonix@localhost>
# Binary package for the holesail-gui desktop app.
# Build with ./build.sh (copies the release binary + resources, runs makepkg).

pkgname=holesail-gui
pkgver=0.1.0
pkgrel=1
pkgdesc="Desktop GUI for Holesail — peer-to-peer TCP/UDP tunnel sharing"
arch=('x86_64')
url="https://github.com/holesail/holesail"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3')
source=(
  'holesail-gui-bin'
  'resources.tar.zst'
  'wrapper.sh'
  'holesail-gui.desktop'
  'holesail-gui.png'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  # binary + worker + node_modules live together; resource_dir = exe dir
  install -Dm755 "$srcdir/holesail-gui-bin" "$pkgdir/usr/lib/holesail-gui/holesail-gui"
  install -dm755 "$pkgdir/usr/lib/holesail-gui"
  tar -xf "$srcdir/resources.tar.zst" -C "$pkgdir/usr/lib/holesail-gui/"

  # launcher wrapper on PATH
  install -Dm755 "$srcdir/wrapper.sh" "$pkgdir/usr/bin/holesail-gui"

  # desktop entry + icon
  install -Dm644 "$srcdir/holesail-gui.desktop" "$pkgdir/usr/share/applications/holesail-gui.desktop"
  install -Dm644 "$srcdir/holesail-gui.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/holesail-gui.png"
}
