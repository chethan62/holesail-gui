{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "holesail-gui",
  "version": "0.2.1",
  "identifier": "io.holesail.gui",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Holesail GUI",
        "width": 980,
        "height": 760,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["hs"]
      },
      "mobile": [
        {
          "scheme": ["hs"],
          "appLink": false
        }
      ]
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/chethan62/holesail-gui/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCQjQ4QTVBMUE1NTE0MApSV1JBVWFXaHBVaTdEWWNsSS9LM1JrMlBXWDByWDN3cnRUaThqUys1U1NSR2FoWVFmUEd3Y0dVcQo="
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist-resources/service-worker.js": "service-worker.js",
      "../dist-resources/node_modules": "node_modules"
    }
  }
}
